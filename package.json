{
  "name": "@kontourai/fieldwork",
  "version": "0.6.1",
  "description": "Local, grounded extraction review with portable reviewed output.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kontourai/fieldwork"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fieldwork": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host-descriptor": {
      "types": "./dist/host-descriptor.d.ts",
      "import": "./dist/host-descriptor.js"
    },
    "./runtime": {
      "types": "./dist/runtime-contracts.d.ts",
      "import": "./dist/runtime-contracts.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:examples": "tsx --test test/examples.test.ts test/vendor-renewal-example.test.ts",
    "test:conformance": "tsx --test test/conformance.test.ts test/format-conformance.test.ts test/provider-conformance.test.ts",
    "test:api": "tsx test/api.test.ts",
    "test:cli": "tsx test/cli.test.ts",
    "test:a11y": "playwright test test/browser/a11y.spec.ts",
    "test:browser": "playwright test",
    "test:package": "npm run build && npm pack --dry-run && node scripts/package-smoke.mjs",
    "check:content": "node scripts/check-content-boundary.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "check:guards": "node scripts/check-guards.mjs",
    "check:veritas": "veritas readiness --working-tree",
    "trust-reconcile-verify": "npm run verify",
    "verify:static": "npm run typecheck && npm run build && npm test && npm run test:examples && npm run test:conformance && npm run test:cli && npm run test:api && npm run test:a11y && npm run test:browser && npm run test:package && npm run check:content && npm run check:decisions",
    "verify": "npm run verify:static && npm run check:veritas",
    "workflow:sidecar": "flow-agents-workflow-sidecar",
    "workflow:validate-artifacts": "flow-agents-validate-artifacts"
  },
  "trust-reconcile-manifest": [
    {
      "id": "full-verification",
      "command": "npm run verify"
    }
  ],
  "dependencies": {
    "@kontourai/datum": "0.7.0",
    "@kontourai/dispatch": "0.5.0",
    "@kontourai/forage": "0.5.0",
    "@kontourai/lookout": "0.3.4",
    "@kontourai/relay": "0.6.0",
    "@kontourai/surface": "2.13.0",
    "@kontourai/survey": "2.5.0",
    "@kontourai/traverse": "0.25.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@kontourai/flow-agents": "5.5.0",
    "@kontourai/ui": "^1.11.1",
    "@kontourai/veritas": "1.5.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
